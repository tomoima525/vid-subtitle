{
  "server": {
    "name": "vid-subtitle",
    "version": "1.0.0",
    "description": "MCP server for video subtitle processing and file access"
  },
  "video_processing": {
    "max_video_size": 1073741824,
    "supported_video_formats": [".mp4", ".mov"],
    "supported_subtitle_formats": [".srt"],
    "temp_directory": "/tmp/vid-subtitle",
    "cleanup_temp_files": true,
    "ffmpeg_timeout": 3600
  },
  "openai": {
    "model": "whisper-1",
    "api_key_env_var": "OPENAI_API_KEY",
    "max_retries": 3
  },
  "transport": {
    "type": "stdio",
    "sse": {
      "host": "localhost",
      "port": 3000,
      "cors_enabled": true
    }
  },
  "roots": [
    {
      "uri": "file:///Users/your_repo_/vid-subtitle",
      "name": "Project Workspace",
      "description": "Main project directory"
    }
  ],
  "security": {
    "max_file_size": 10485760,
    "max_directory_depth": 10,
    "allowed_extensions": ["*"],
    "denied_extensions": [".key", ".pem", ".p12", ".pfx", ".env", ".secret"],
    "enable_content_search": true,
    "max_search_results": 100,
    "max_concurrent_operations": 5
  },
  "features": {
    "read_files": true,
    "write_files": true,
    "create_directories": true,
    "delete_files": false,
    "move_files": false,
    "copy_files": false,
    "read_binary_files": true,
    "symbolic_links": false,
    "hidden_files": false
  },
  "logging": {
    "level": "INFO",
    "security_events": true,
    "file_operations": true
  },
  "performance": {
    "cache_file_info": true,
    "cache_duration_seconds": 300,
    "async_operations": true,
    "compression_enabled": false,
    "compression_threshold": 1024
  }
}
